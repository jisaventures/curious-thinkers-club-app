# Leave these empty to run demo mode (in-memory Sam / Pip / Lou / Mo, no Docker).
# Set NEXT_PUBLIC_DEMO_MODE=true to force demo mode even when the keys below are set.
# Set NEXT_PUBLIC_DEMO_MODE=false to require Supabase.
# NEXT_PUBLIC_DEMO_MODE=

# Server-only. Do not prefix the Supabase keys with NEXT_PUBLIC.
# Local `npx supabase start` prints the URL and keys.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where this app is served. Magic links redirect here.
SITE_URL=http://127.0.0.1:43123

# Public shop link in the header. Not used to place orders.
NEXT_PUBLIC_SHOP_URL=https://curiousthinkersclub.org

# Local demo buttons for the seeded family. Leave unset on Vercel.
DEV_DEMO_LOGIN=true

# supabase = magic link. shopify = stub until the Customer Account API is connected.
AUTH_PROVIDER=supabase

# Shopify custom app. Leave blank in v1. Never expose the secrets to the browser.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_ISSUER=
SHOPIFY_WEBHOOK_SECRET=
